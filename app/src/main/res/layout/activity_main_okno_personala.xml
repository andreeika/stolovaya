<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cL"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#64B5F6"
    tools:context=".MainActivity">

    <Button
        android:id="@+id/saveButton4"
        android:layout_width="240dp"
        android:layout_height="54dp"
        android:layout_x="201dp"
        android:layout_y="77dp"
        android:background="@drawable/ripple_effect_btn_round"
        android:fontFamily="@font/montserrat_medium"
        android:text="Завершить заказ"
        android:textAlignment="center"
        android:textSize="20sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.497"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.791" />

    <Button
        android:id="@+id/button11"
        android:layout_width="200dp"
        android:layout_height="54dp"
        android:layout_x="201dp"
        android:layout_y="77dp"
        android:background="@drawable/ripple_effect_btn_korzina"
        android:fontFamily="@font/montserrat_medium"
        android:text="Создать меню"
        android:textAlignment="center"
        android:textSize="20sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toTopOf="@+id/button13"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.9" />

    <Button
        android:id="@+id/button13"
        android:layout_width="200dp"
        android:layout_height="54dp"
        android:layout_x="201dp"
        android:layout_y="77dp"
        android:background="@drawable/ripple_effect_btn_korzina"
        android:fontFamily="@font/montserrat_medium"
        android:text="Обновить"
        android:textAlignment="center"
        android:textSize="20sp"
        app:backgroundTint="@null"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.134" />

    <ImageView
        android:id="@+id/imageView15"
        android:layout_width="83dp"
        android:layout_height="83dp"
        android:layout_x="21dp"
        android:layout_y="63dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.048"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.058"
        app:srcCompat="@drawable/mask_group" />

    <ImageView
        android:id="@+id/imageView16"
        android:layout_width="191dp"
        android:layout_height="54dp"
        android:layout_x="106dp"
        android:layout_y="777dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.923"
        app:srcCompat="@drawable/sibsiu_logo_main" />

    <TextView
        android:id="@+id/textView2"
        android:layout_width="282dp"
        android:layout_height="32dp"
        android:layout_x="21dp"
        android:layout_y="283dp"
        android:clickable="true"
        android:contextClickable="true"
        android:cursorVisible="true"
        android:fontFamily="@font/montserrat_medium"
        android:gravity="center_vertical|left"
        android:text="Активные заказы"
        android:textAlignment="center"
        android:textColor="#FFFDFD"
        android:textSize="24sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.496"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.23"
        tools:ignore="TouchTargetSizeCheck" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView_zakaz"
        android:layout_width="400dp"
        android:layout_height="357dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.476"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.446"
        tools:itemCount="100"
        tools:listitem="@layout/recycler_okno_personala" />


</androidx.constraintlayout.widget.ConstraintLayout>